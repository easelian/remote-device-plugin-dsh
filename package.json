{
  "name": "dsh-remote-device-hub",
  "version": "0.3.0",
  "description": "Connect authorized Linux and macOS devices to DeepSeek Harness through Remote Device Hub MCP.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./launcher": "./bin/launcher.mjs",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.png"
  },
  "bin": {
    "dsh-remote-device-hub-mcp": "./bin/launcher.mjs"
  },
  "icon": "./assets/icon.png",
  "files": [
    "index.js",
    "client.js",
    "bin/*.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "assets/*.png",
    "skills/**",
    "docs/*.md",
    "market/*.json",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "mcp",
    "remote-device-hub",
    "remote-development"
  ],
  "license": "UNLICENSED",
  "author": {
    "name": "Hongfei Shang",
    "email": "shfwin6@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/be-one-click/remote-device-plugin-dsh.git"
  },
  "homepage": "https://github.com/be-one-click/remote-device-plugin-dsh#readme",
  "bugs": {
    "url": "https://github.com/be-one-click/remote-device-plugin-dsh/issues"
  },
  "engines": {
    "dsh": ">=0.2.0",
    "node": ">=22"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "mcp-remote": "^0.15.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-plugin-market-index": "0.2.1-rc.2",
    "semver": "^7.8.5"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate.mjs",
    "market": "node scripts/market-index.mjs",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run check",
    "check": "npm run validate && npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
