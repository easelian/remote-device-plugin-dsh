{
  "name": "dsh-remote-device-hub",
  "version": "0.3.12",
  "description": "Connect authorized devices to DeepSeek Harness through Remote Device Hub MCP.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./launcher": "./bin/launcher.mjs",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.svg"
  },
  "bin": {
    "dsh-remote-device-hub-mcp": "./bin/launcher.mjs"
  },
  "icon": "./assets/icon.svg",
  "files": [
    "index.js",
    "permissions.js",
    "client.js",
    "bin/*.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "assets/*.svg",
    "skills/**",
    "docs/*.md",
    "market/*.json",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "mcp",
    "remote-device-hub",
    "remote-development"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "Easelian",
    "email": "easeliannet@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/easelian/remote-device-plugin-dsh.git"
  },
  "homepage": "https://rdh.easelian.com",
  "bugs": {
    "url": "https://github.com/easelian/remote-device-plugin-dsh/issues"
  },
  "engines": {
    "dsh": ">=0.2.0",
    "node": ">=22"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "mcp-remote": "^0.15.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@deepseek-ai/dsh-plugin-market-index": "0.2.1-rc.2",
    "@types/node": "22.20.5",
    "@types/react": "19.2.14",
    "@types/semver": "7.7.1",
    "semver": "^7.8.5",
    "typescript": "7.0.2"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate.mjs",
    "market": "node scripts/market-index.mjs",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run check",
    "check": "npm run build && npm run validate && npm test",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "prepack": "npm run build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "style:check": "biome check ."
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
